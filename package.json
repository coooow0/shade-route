{
  "name": "shade-route",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "granite dev",
    "prebuild": "npm run data:verify",
    "build": "ait build",
    "deploy": "ait deploy",
    "lint": "eslint .",
    "format": "prettier --write .",
    "data:tiles": "node scripts/build-route-tiles.mjs",
    "data:seoul": "node --max-old-space-size=4096 scripts/build-seoul-tiles.mjs",
    "data:verify": "node scripts/verify-seoul-artifacts.mjs",
    "data:boundary": "node scripts/build-seoul-boundary.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@apps-in-toss/web-framework": "^2.10.5",
    "@emotion/react": "^11.0.0",
    "@toss/tds-colors": "0.1.0",
    "@toss/tds-mobile": "2.5.0",
    "@toss/tds-mobile-ait": "2.5.0",
    "leaflet": "^1.9.4",
    "rbush": "4.0.1",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "suncalc": "1.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/leaflet": "^1.9.21",
    "@types/rbush": "4.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/suncalc": "1.9.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "jsdom": "^29.1.1",
    "osm-pbf-parser": "^2.3.0",
    "prettier": "^3.4.2",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.2.0",
    "vitest": "^4.1.10"
  }
}
